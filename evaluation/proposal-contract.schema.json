{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JadwAI proposal-contract-v1",
  "description": "Draft proposals only. Context validation, decision consistency and explicit human approval are separate requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "proposals",
    "clarifications",
    "unsupported"
  ],
  "properties": {
    "decision": {
      "enum": [
        "ready",
        "clarify",
        "unsupported",
        "conflict",
        "mixed"
      ]
    },
    "proposals": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "data"
            ],
            "properties": {
              "kind": {
                "const": "rule"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "instructor_id",
                  "day",
                  "start_hour",
                  "end_hour",
                  "strength"
                ],
                "properties": {
                  "type": {
                    "const": "unavailable"
                  },
                  "instructor_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "day": {
                    "enum": [
                      "Sunday",
                      "Monday",
                      "Tuesday",
                      "Wednesday",
                      "Thursday",
                      "Friday",
                      "Saturday"
                    ]
                  },
                  "start_hour": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 23
                  },
                  "end_hour": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 24
                  },
                  "strength": {
                    "const": "mandatory"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "data"
            ],
            "properties": {
              "kind": {
                "const": "rule"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "instructor_id",
                  "day",
                  "start_hour",
                  "end_hour",
                  "strength"
                ],
                "properties": {
                  "type": {
                    "const": "preferred_period"
                  },
                  "instructor_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "day": {
                    "enum": [
                      "Sunday",
                      "Monday",
                      "Tuesday",
                      "Wednesday",
                      "Thursday",
                      "Friday",
                      "Saturday"
                    ]
                  },
                  "start_hour": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 23
                  },
                  "end_hour": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 24
                  },
                  "strength": {
                    "const": "preferred"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "data"
            ],
            "properties": {
              "kind": {
                "const": "rule"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "room_id",
                  "day",
                  "start_hour",
                  "end_hour",
                  "strength"
                ],
                "properties": {
                  "type": {
                    "const": "room_unavailable"
                  },
                  "room_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "day": {
                    "enum": [
                      "Sunday",
                      "Monday",
                      "Tuesday",
                      "Wednesday",
                      "Thursday",
                      "Friday",
                      "Saturday"
                    ]
                  },
                  "start_hour": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 23
                  },
                  "end_hour": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 24
                  },
                  "strength": {
                    "const": "mandatory"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "data"
            ],
            "properties": {
              "kind": {
                "const": "rule"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "group_id",
                  "day",
                  "start_hour",
                  "end_hour",
                  "strength"
                ],
                "properties": {
                  "type": {
                    "const": "group_unavailable"
                  },
                  "group_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "day": {
                    "enum": [
                      "Sunday",
                      "Monday",
                      "Tuesday",
                      "Wednesday",
                      "Thursday",
                      "Friday",
                      "Saturday"
                    ]
                  },
                  "start_hour": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 23
                  },
                  "end_hour": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 24
                  },
                  "strength": {
                    "const": "mandatory"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "data"
            ],
            "properties": {
              "kind": {
                "const": "rule"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "activity_id",
                  "day",
                  "start_hour",
                  "end_hour",
                  "strength"
                ],
                "properties": {
                  "type": {
                    "const": "activity_allowed"
                  },
                  "activity_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "day": {
                    "enum": [
                      "Sunday",
                      "Monday",
                      "Tuesday",
                      "Wednesday",
                      "Thursday",
                      "Friday",
                      "Saturday"
                    ]
                  },
                  "start_hour": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 23
                  },
                  "end_hour": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 24
                  },
                  "strength": {
                    "const": "mandatory"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "data"
            ],
            "properties": {
              "kind": {
                "const": "rule"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "group_id",
                  "day",
                  "start_hour",
                  "end_hour",
                  "strength"
                ],
                "properties": {
                  "type": {
                    "const": "group_allowed"
                  },
                  "group_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "day": {
                    "enum": [
                      "Sunday",
                      "Monday",
                      "Tuesday",
                      "Wednesday",
                      "Thursday",
                      "Friday",
                      "Saturday"
                    ]
                  },
                  "start_hour": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 23
                  },
                  "end_hour": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 24
                  },
                  "strength": {
                    "const": "mandatory"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "data"
            ],
            "properties": {
              "kind": {
                "const": "instructor_weekly_limit"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "instructor_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "max_weekly_hours": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 168,
                    "multipleOf": 0.5
                  }
                },
                "required": [
                  "instructor_id",
                  "max_weekly_hours"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "data"
            ],
            "properties": {
              "kind": {
                "const": "realism_policy"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "student_daily_hours": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 24,
                    "multipleOf": 0.5
                  },
                  "instructor_daily_hours": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 24,
                    "multipleOf": 0.5
                  }
                },
                "required": []
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "data"
            ],
            "properties": {
              "kind": {
                "const": "assignment_lock"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "source_run_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "activity_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "occurrence": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9
                  },
                  "keep_instructor": {
                    "type": "boolean"
                  },
                  "keep_time": {
                    "type": "boolean"
                  },
                  "keep_room": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "source_run_id",
                  "activity_id",
                  "occurrence",
                  "keep_instructor",
                  "keep_time",
                  "keep_room"
                ]
              }
            }
          }
        ]
      }
    },
    "clarifications": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unsupported": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
