DATABASE_URL=postgresql+psycopg://mizan:mizan_local@127.0.0.1:5440/mizan
JADWAI_ADMIN_EMAIL=admin@jadwai.local
# Set a password of at least 12 characters before seeding.
JADWAI_ADMIN_PASSWORD=

# Setup creates DATABASE_ADMIN_URL (migration owner) and separate DATABASE_URL / WORKER_DATABASE_URL runtime credentials.
# For an HTTPS deployment, set JADWAI_COOKIE_SECURE=true.

# JAI model: GPT-5.4 mini. Calls stay disabled until deliberately enabled.
JADWAI_AI_ENABLED=false
# Set server-side only; never use a VITE_ variable or commit a real key.
OPENAI_API_KEY=
